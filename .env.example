# Family Expenses: environment variables.
# Copy to .env for `vercel dev` (it reads .env, not .env.local), and set the same
# names in the Vercel project for Preview and Production. Never commit .env.

# Shared Household secret typed on a device to pair it. At least 10 characters
# (the `auth` function refuses to pair with a shorter one); longer is better,
# since it is the only thing between a stranger and the Ledger.
FAMILY_ACCESS_CODE=

# Random secret that signs Session cookies and Pair Codes. At least 32
# characters (`openssl rand -base64 32`). Rotating it unpairs every device.
JWT_SECRET=

# OAuth client for the Admin's Google account (SETUP_GUIDE.md, step 2).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Long-lived refresh token for that account with the `drive` and `spreadsheets`
# scopes (SETUP_GUIDE.md, step 3).
GOOGLE_REFRESH_TOKEN=

# ID of the Drive folder that holds the Ledger and the Receipt Store. Use a
# separate folder for local development.
GOOGLE_DRIVE_FOLDER_ID=

# Optional: ID of an existing Ledger spreadsheet. Leave blank and Bootstrap
# creates `Expenses_Database` inside the folder above.
GOOGLE_SHEET_ID=

# Gemini API key used for Receipt OCR. Billing must be enabled before real
# receipts are sent.
GEMINI_API_KEY=

# Gemini model ID for OCR. Defaults to gemini-3.5-flash-lite when blank.
GEMINI_MODEL=gemini-3.5-flash-lite
